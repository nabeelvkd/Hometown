# API base URL the Expo app talks to (EXPO_PUBLIC_* is inlined at bundle time).
#
# ACTIVE: USB device via `adb reverse tcp:5001 tcp:5001` — the phone's
# localhost:5001 is forwarded to this PC. No firewall/Wi-Fi setup needed.
# Keep the phone plugged in; if you unplug/replug, re-run the adb reverse command.
EXPO_PUBLIC_API_URL=http://10.183.115.105:5001/api

# Wi-Fi alternative (no USB): use this machine's LAN IP, but this needs an
# inbound firewall rule for TCP 5001 (run PowerShell as Administrator):
#   New-NetFirewallRule -DisplayName "OneVillage API 5001" -Direction Inbound -Action Allow -Protocol TCP -LocalPort 5001
# and the phone on the SAME Wi-Fi (current network is "Public" + may isolate clients).
# EXPO_PUBLIC_API_URL=http://10.183.115.105:5001/api
