# Server
PORT=5001
NODE_ENV=development

# Database
# Local:  mongodb://127.0.0.1:27017/nattile
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nattile?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/nattile

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS (comma-separated list of allowed origins, or * for all)
CORS_ORIGIN=*

# Cloudinary (image uploads) — from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
